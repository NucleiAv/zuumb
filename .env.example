# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Anthropic (the one real cost) ---
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Wazuh indexer (Phase 12 live ingestion) ---
# Alerts live in the indexer's wazuh-alerts-* indices, NOT the Manager API.
# Docker runs under WSL here, so the indexer is reachable on localhost from Windows.
# Use a dedicated READ-ONLY OpenSearch user (see README "Live Wazuh"), not admin.
WAZUH_API_URL=https://localhost:9200
WAZUH_API_USER=zuumb-ingest
WAZUH_API_PASSWORD=changeme
WAZUH_VERIFY_SSL=false
WAZUH_ALERTS_INDEX=wazuh-alerts-*
WAZUH_LIVE_POLLING=false          # true -> app.main starts the background poller (first cycle fires at once)
WAZUH_POLL_SECONDS=60

# --- Database ---
# POC default: local SQLite file. MVP: `docker compose up -d postgres` then use the URL below.
DATABASE_URL=sqlite:///./zuumb.db
# DATABASE_URL=postgresql://aisoc:aisoc@localhost:5432/aisoc

# --- Correlation ---
CORRELATION_WINDOW_MINUTES=30
