# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Anthropic (the one real cost) ---
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Wazuh API (external stack; MVP live polling only, unused by the POC) ---
# Docker runs under WSL here, so the stack is reachable on localhost from Windows.
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh
WAZUH_VERIFY_SSL=false

# --- Database ---
# POC default: local SQLite file. MVP: `docker compose up -d postgres` then use the URL below.
DATABASE_URL=sqlite:///./ai_soc_xdr.db
# DATABASE_URL=postgresql://aisoc:aisoc@localhost:5432/aisoc

# --- Correlation ---
CORRELATION_WINDOW_MINUTES=30
