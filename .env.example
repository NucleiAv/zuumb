# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Anthropic (the one real cost) ---
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Wazuh indexer (Phase 12 live ingestion) ---
# Alerts live in the indexer's wazuh-alerts-* indices, NOT the Manager API.
# Docker runs under WSL here, so the indexer is reachable on localhost from Windows.
# Use a dedicated READ-ONLY OpenSearch user (see README "Live Wazuh"), not admin.
WAZUH_API_URL=https://localhost:9200
WAZUH_API_USER=zuumb-ingest
WAZUH_API_PASSWORD=changeme
WAZUH_VERIFY_SSL=false
WAZUH_ALERTS_INDEX=wazuh-alerts-*
WAZUH_LIVE_POLLING=false          # true -> app.main starts the background poller (first cycle fires at once)
WAZUH_POLL_SECONDS=60

# --- Database ---
# POC default: local SQLite file. MVP: `docker compose up -d postgres` then use the URL below.
DATABASE_URL=sqlite:///./zuumb.db
# DATABASE_URL=postgresql://aisoc:aisoc@localhost:5432/aisoc

# NOTE for the Docker stack (docker-compose.yml): the container's "localhost" is
# not the host. Point the two URLs above at host.docker.internal instead, e.g.
#   WAZUH_API_URL=https://host.docker.internal:9200
#   WAZUH_AR_API_URL=https://host.docker.internal:55000

# --- Correlation / attack chains ---
CORRELATION_WINDOW_MINUTES=30
CHAIN_MAX_ENTITY_SPREAD=4         # an entity in more incidents than this is a hub, not a chain link

# --- Active response (Phase 14) ---
# A SEPARATE least-privilege Manager API user — NOT the ingestion credential.
# Its RBAC policy must allow only active-response:command (see README "Active response").
WAZUH_AR_API_URL=https://localhost:55000
WAZUH_AR_API_USER=zuumb-ar
WAZUH_AR_API_PASSWORD=changeme
# RESPONSE_DRY_RUN=true  -> approving an action task records the intent and touches
# NOTHING. Set it to false ONLY when you want approvals to run real commands
# (firewall-drop / disable-account) on the target agent. Leave it true unless you
# are certain what flipping it means for your environment.
RESPONSE_DRY_RUN=true
RESPONSE_RATE_LIMIT_SECONDS=30    # min gap between two *live* dispatches
